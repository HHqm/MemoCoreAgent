# 复制为 .env 后填写。不要把 .env 提交到仓库。
DEEPSEEK_API_KEY=
# 任意 OpenAI 兼容端点都可以；MEMOCORE_API_KEY 优先于 DEEPSEEK_API_KEY。
MEMOCORE_BASE_URL=https://api.deepseek.com
MEMOCORE_ANSWER_MODEL=deepseek-chat
# 留空则与回答模型相同。
MEMOCORE_JUDGE_MODEL=

MEMOCORE_EMBEDDING_MODEL=BAAI/bge-m3
# cuda / cpu，留空自动选择。
MEMOCORE_EMBEDDING_DEVICE=
